    <!-- Privacy & Research Consent Popup -->
    <string name="consent_title">Help improve bus travel</string>
    <string name="consent_summary">Bus Sathi records your trip routes (GPS points, trip times and distance) along with your driver and vehicle details.\n\nWe would like to use this data for research on bus routes and public transport. Do you allow your data to be used for research?\n\nYour consent is required to use Bus Sathi.</string>
    <string name="consent_details_show">Read full privacy details</string>
    <string name="consent_details_hide">Hide privacy details</string>
    <string name="consent_details">What we collect\n• Account details you enter when registering: name, email, phone number, vehicle number, license number, city and vehicle capacity.\n• Trip data while a trip is active: GPS location points (latitude, longitude, time and accuracy), trip start and end time, and total distance.\n\nWhy we collect it\n• To run the app: recording your trips and showing the leaderboard.\n• For research on bus routes, travel patterns and public transport planning.\n\nYour choice\n• Location is recorded only between Start Trip and End Trip.\n• Bus Sathi is a research app, so it can only be used if you accept. If you decline, the app will close and no further data is collected.</string>
    <string name="consent_required_title">Consent required</string>
    <string name="consent_required_message">Bus Sathi can only be used if you allow your data to be used for research. Without your consent the app will close.</string>
